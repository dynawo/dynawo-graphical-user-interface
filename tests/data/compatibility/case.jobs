<?xml version="1.0" encoding="UTF-8"?>
<!-- A job for the compatibility check, against tests/fake_dynawo.py. -->
<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:job name="case">
    <dyn:solver lib="dynawo_SolverIDA" parFile="case.par" parId="IDA"/>
    <dyn:modeler compileDir="outputs/compilation">
      <dyn:network iidmFile="case.iidm" parFile="case.par" parId="Network"/>
      <dyn:dynModels dydFile="case.dyd"/>
      <dyn:dynModels dydFile="missing.dyd"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="10"/>
    <dyn:outputs directory="outputs"/>
  </dyn:job>
</dyn:jobs>
