<?xml version="1.0" encoding="UTF-8"?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- KEEP_ME is not an event set: it must survive saving events. -->
  <set id="KEEP_ME">
    <par type="DOUBLE" name="generator_H" value="5.4"/>
  </set>
  <set id="OLD_EVENT">
    <par type="DOUBLE" name="event_tEvent" value="1"/>
    <par type="BOOL" name="event_disconnectOrigin" value="true"/>
    <par type="BOOL" name="event_disconnectExtremity" value="true"/>
  </set>
  <set id="MACRO_EVENT">
    <par type="DOUBLE" name="event_tEvent" value="2"/>
    <par type="BOOL" name="event_disconnectOrigin" value="true"/>
    <par type="BOOL" name="event_disconnectExtremity" value="false"/>
  </set>
</parametersSet>
